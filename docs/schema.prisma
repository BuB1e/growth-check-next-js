generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
generator prismabox {
  provider                    = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
  inputModel                  = true
  output                      = "../generated/prismabox"
}


model aiPrediction	{
	id									Int			@id @default(autoincrement()) @db.Integer
	childId								Int			@db.Integer
	heightDevelopmentId					Int			@db.Integer
	weightDevelopmentId					Int			@db.Integer
	dataMonthsUsed						Int			@db.SmallInt
	modelUsed							String		@db.VarChar(20)
	modelVersion						String		@db.VarChar(3) //1.0
	dateTime							DateTime	@db.Date
	month								Int			@db.SmallInt
	height								Float		@db.Real
	weight								Float		@db.Real
	createdAt							DateTime	@default(now()) @db.Date

	child								Child		@relation(fields: [childId], references: [id])
	heightDevelopment					Development		@relation("HeightDevelopment", fields: [heightDevelopmentId], references: [id])
	weightDevelopment					Development		@relation("WeightDevelopment", fields: [weightDevelopmentId], references: [id])
}

model User {
    id              String  @id @default(uuid()) @db.Uuid
    email           String
    firstName        String
    lastName       String
    teamId         Int?
    role            Role      @default(USER)
    emailVerified   Boolean   @default(false)
    image           String?
    deleteStatus   Boolean   @default(false)
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @default(now()) @updatedAt
    sessions        Session[]
    accounts        Account[]

    location_create_request LocationCreateRequest[]
    child_treanfer_request  ChildTransferRequest[]
    Child                   Child[]
    UserCreateStatus       UserCreateStatus?

    team            Team? @relation(fields: [teamId],references: [id])
    @@unique([email])
    @@map("user")
}

model Session {
	id        String   @id
    expiresAt DateTime
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String    @db.Uuid
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String    @db.Uuid
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @default(now()) @updatedAt

    @@map("verification")
}

enum Role {
    ADMIN
    USER
    HEAD
}

model Child {
	id				Int			@id	@default(autoincrement()) @db.Integer
	firstName		String		@db.VarChar(50)
	lastName		String		@db.VarChar(50)
	locationId		Int			@db.Integer
	birthDate		DateTime	@db.Date
	createdByUser	String		@db.Uuid
	updatedByUser	String		@db.Uuid
	createdAt		DateTime	@default(now()) @db.Date
	updatedAt		DateTime	@default(now()) @updatedAt @db.Date
	deleteStatus	Boolean		@default(false) @db.Boolean

	childData		ChildData[]
	location		Location	@relation(fields: [locationId], references: [id])
	user			User		@relation(fields: [createdByUser], references: [id])
	aiPrediction	aiPrediction[]
}

model ChildData {
	id						Int							@id	@default(autoincrement()) @db.Integer
	childId				Int							@db.Integer
	locationId				Int							@db.Integer
	height					Float						@db.Real
	weight					Float						@db.Real
	heightDevelopmentId	Int							@db.Integer
	weightDevelopmentId	Int							@db.Integer
	// index is the measurement number
	index					Int							@db.Integer
	heightDate				DateTime					@db.Date

	userCreated				String						@db.Uuid
	userUpdated				String						@db.Uuid
	createdAt				DateTime					@default(now()) @db.Date
	updatedAt				DateTime					@default(now()) @updatedAt @db.Date
	deleteStatus			Boolean						@default(false) @db.Boolean
	status					Child_status				@default(IN_AREA)

	child					Child						@relation(fields: [childId], references: [id])
	location				Location					@relation(fields: [locationId], references: [id])
	heightDevelopment		Development					@relation("ChildDataHeightDev", fields: [heightDevelopmentId], references: [id])
	weightDevelopment		Development					@relation("ChildDataWeightDev", fields: [weightDevelopmentId], references: [id])

}


enum Child_status {
	IN_AREA
	OUT_AREA
	UNKNOWN
	DIED
}

model ChildTransferRequest {
	id				Int			@id @default(autoincrement()) @db.Integer
	userId			String		@db.Uuid
	childId		Int			@db.Integer
	fromLocation	Int			@db.Integer
	toLocation		Int			@db.Integer
	handledBy		String 		@db.Uuid
	createdAt		DateTime	@default(now()) @db.Date
	updatedAt		DateTime	@default(now()) @updatedAt @db.Date
	deleteStatus	Boolean		@default(false) @db.Boolean

	user			User		@relation(fields: [userId], references: [id])
}

model Development {
	id					Int			@id @default(autoincrement()) @db.Integer
	status				String		@db.VarChar(20)
	metric				Metric_type
	detail				String?		@db.VarChar
	minAge				Int			@db.SmallInt
	maxAge				Int			@db.SmallInt
	suggestion			String		@db.VarChar
	createdAt			DateTime	@default(now()) @db.Date
	updatedAt			DateTime	@default(now()) @updatedAt @db.Date
	deleteStatus		Boolean		@default(false) @db.Boolean

	heightChildData			ChildData[]		@relation("ChildDataHeightDev")
	weightChildData			ChildData[]		@relation("ChildDataWeightDev")
	heightPredictions		aiPrediction[]	@relation("HeightDevelopment")
	weightPredictions		aiPrediction[]	@relation("WeightDevelopment")
}

enum Metric_type {
	WA	// Weight-for-age
	HA	// Height-for-age
	BMI	// BMI-for-age
	WH	// Weight-for-height (ถ้าใช้ในอนาคต)
	WL	// Weight-for-length
}

model Location {
	id							Int			@id @default(autoincrement()) @db.Integer
	name						String		@db.VarChar(50)
	map							String		@db.VarChar(50)
	province					String		@db.VarChar(50)
	district					String		@db.VarChar(50)
	subDistrict				String		@db.VarChar(50)
	zipCode					String		@db.VarChar(5)
	teamId						Int			@db.Integer @unique  // one to one
	requestId					Int			@db.Integer @unique	 // one to one
	createdByUser				String		@db.Uuid
	createdAt					DateTime	@default(now()) @db.Date
	updatedAt					DateTime	@default(now()) @updatedAt @db.Date
	deleteStatus				Boolean		@default(false) @db.Boolean

	team						Team		@relation(fields: [teamId],references: [id])
	locationCreateRequest		LocationCreateRequest	@relation(fields: [requestId], references: [id])
	child						Child[]
	child_data					ChildData[]
}

model LocationCreateRequest {
	id				Int			@id @default(autoincrement()) @db.Integer
	userId			String		@db.Uuid
	locationName	String		@db.VarChar(50)
	locationMap	String		@db.VarChar(50)
	province		String		@db.VarChar(30)
	district		String		@db.VarChar(30)
	sub_district	String		@db.VarChar(30)
	zip_code		String		@db.VarChar(5)
	status			Request_status	@default(WAITING)
	handledBy		String @db.Uuid
	createdAt		DateTime	@default(now()) @db.Date
	updatedAt		DateTime	@default(now()) @updatedAt @db.Date
	deleteStatus	Boolean		@default(false) @db.Boolean

	location		Location?
	user			User		@relation(fields: [userId], references: [id])
}

enum Request_status {
	APPROVE
	REJECT
	WAITING
}

model Parent {
	id					Int			@id @default(autoincrement()) @db.Integer
	identificationId	String		@db.VarChar(13)	@unique
	firstName			String		@db.VarChar(50)
	lastName			String		@db.VarChar(50)
	phoneNo				String		@db.VarChar(10) @unique
	gender				Gender
	detail				String?		@db.VarChar(30)
	createdAt			DateTime	@default(now()) @db.Date
	updatedAt			DateTime	@default(now()) @updatedAt @db.Date
	deleteStatus		Boolean		@default(false) @db.Boolean

	child_parent		ChildParent[]
}

enum Gender {
	MALE
	FEMALE
}

model Team {
	id				Int			@id @default(autoincrement()) @db.Integer
	name			String		@db.VarChar(20)
	user			User[]
	location		Location?
	createdAt		DateTime	@default(now()) @db.Date
	updatedAt		DateTime	@default(now()) @updatedAt @db.Date
	deleteStatus	Boolean		@default(false) @db.Boolean
}

model UserCreateStatus {
    id            String         @id @default(uuid()) @db.Uuid
    userId        String         @unique @db.Uuid
    requestStatus Request_status @default(WAITING)
    rejectReason  String?        @db.VarChar(255)
    updatedBy     String?        @db.Uuid
    updatedAt     DateTime?      @db.Date
    createdAt     DateTime       @default(now()) @db.Date

    user User @relation(fields: [userId], references: [id])
}
