# GrowthCheck Frontend Environment Variables

# Backend API / Better Auth Endpoint (required)
BACKEND_ENDPOINT=http://your_backend_endpoint.com
BETTER_AUTH_SECRET=

# Pagination Mobile
PAGINATION_LIMIT_MOBILE_SIZE=6

# Pagination Desktop
PAGINATION_LIMIT_DESKTOP_SIZE=10

# AI Prediction Polling (desktop)
# Initial polling delay in milliseconds
AI_PREDICTION_POLL_INITIAL_MS=2500
# Polling backoff multiplier per attempt
AI_PREDICTION_POLL_BACKOFF_FACTOR=1.7
# Maximum polling delay in milliseconds
AI_PREDICTION_POLL_MAX_MS=12000
# Total polling timeout window in milliseconds
AI_PREDICTION_POLL_TIMEOUT_MS=90000
# Minimum polling delay when browser tab is hidden
AI_PREDICTION_POLL_HIDDEN_MIN_MS=15000
# Polling jitter ratio (0.2 = +/-20%)
AI_PREDICTION_POLL_JITTER_RATIO=0.2
