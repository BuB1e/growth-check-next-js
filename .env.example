# GrowthCheck Frontend Environment Variables

# Backend API Endpoint (required)
# Format: https://your-backend-api.example.com
BACKEND_ENDPOINT=https://api.example.com

# Better Auth Endpoint (required for authentication)
# Format: https://your-better-auth.example.com
NEXT_PUBLIC_BETTER_AUTH_ENDPOINT=https://auth.example.com

# ONLY IN DEV MODE
USE_MOCK_DATA=false
NEXT_PUBLIC_USE_MOCK_DATA=false
DEV_MOCK_ROLE=ADMIN
